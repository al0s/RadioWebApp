{
	"name": "podcast-website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"setup": "npx tsx src/scripts/setup.ts",
		"deploy": "npm run build && vite-node src/scripts/deploy.ts",
		"deploy:beta": "npm run build && vite-node src/scripts/deploy.ts --beta",
		"dev": "vite dev",
		"seo": "vite-node src/scripts/generate-og-image.ts && vite-node src/scripts/generate-sitemap.ts && vite-node src/scripts/generate-podcast-snapshot.ts",
		"assetlinks": "vite-node src/scripts/generate-assetlinks.ts",
		"build": "npm run setup && npm run seo && npm run assetlinks && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"twa:init": "vite-node src/scripts/twa.ts init",
		"twa:update": "vite-node src/scripts/twa.ts update",
		"twa:build": "vite-node src/scripts/twa.ts build"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.3",
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^22.12.0",
		"@vite-pwa/sveltekit": "^1.1.0",
		"autoprefixer": "^10.4.20",
		"daisyui": "^4.12.23",
		"dotenv": "^16.4.7",
		"eslint": "^9.7.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.36.0",
		"fs-extra": "^11.2.0",
		"globals": "^15.0.0",
		"image-size": "^2.0.2",
		"node-fetch": "^3.3.2",
		"prettier": "^3.3.2",
		"prettier-plugin-svelte": "^3.2.6",
		"prettier-plugin-tailwindcss": "^0.6.5",
		"sharp": "^0.33.5",
		"svelte": "^5.46.4",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^3.4.9",
		"tsx": "^4.19.2",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.0.0",
		"vite": "^8.0.16",
		"vite-node": "^6.0.0"
	},
	"dependencies": {
		"fast-xml-parser": "^5.8.0",
		"google-auth-library": "^10.7.0",
		"lucide-svelte": "^0.469.0"
	},
	"overrides": {
		"cookie": "^0.7.2"
	}
}
